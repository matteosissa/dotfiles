<?xml version="1.0" encoding="UTF-8"?>
<!--
  jetbrains-keymap.xml — native PyCharm / JetBrains keymap
  Canonical reference: canonical_vim.md

  Holds the IDE-MANAGEMENT layer ONLY: global Ctrl+Shift bindings that
  must work from ANY focus (editor, terminal, project tree). IdeaVim
  cannot do this — its mappings only fire in the editor — so these live
  here, in the native keymap, not in .ideavimrc. These mirror section 2
  of vscode-keybindings.json; keep the two in sync.

  Ctrl (not meta/Cmd) is used on every OS, so the scheme is identical on
  macOS / Linux / Windows.

  Activate it in Settings -> Keymap (pick "Canonical (Vim + Ctrl+Shift)").
  If the IDE flags a shortcut as already assigned, remove it from the
  conflicting default action — these overrides are intentional. If the
  file fails to import on your version, set the shortcuts by hand in
  Settings -> Keymap; the action IDs below are the ones to search for.
-->
<keymap version="1" name="Canonical (Vim + Ctrl+Shift)" parent="$default">

  <!-- Tool windows / panels (toggle + focus) -->
  <action id="ActivateProjectToolWindow">
    <keyboard-shortcut first-keystroke="ctrl shift E" />
  </action>
  <action id="ActivateVersionControlToolWindow">
    <keyboard-shortcut first-keystroke="ctrl shift G" />
  </action>
  <action id="ActivateDebugToolWindow">
    <keyboard-shortcut first-keystroke="ctrl shift D" />
  </action>
  <action id="ActivateProblemsViewToolWindow">
    <keyboard-shortcut first-keystroke="ctrl shift M" />
  </action>
  <action id="ActivateTerminalToolWindow">
    <keyboard-shortcut first-keystroke="ctrl shift T" />
  </action>
  <!-- Closest match to VS Code's toggleSidebarVisibility: no single JetBrains
       tool window plays the role of "the sidebar", so this hides/restores
       ALL tool windows at once rather than just the project tree. -->
  <action id="HideAllWindows">
    <keyboard-shortcut first-keystroke="ctrl shift B" />
  </action>

  <!-- Search & navigation (global) -->
  <action id="FindInPath">
    <keyboard-shortcut first-keystroke="ctrl shift F" />
  </action>
  <action id="GotoFile">
    <keyboard-shortcut first-keystroke="ctrl shift O" />
  </action>
  <action id="GotoAction">
    <keyboard-shortcut first-keystroke="ctrl shift A" />
  </action>

  <!-- Editor tabs -->
  <action id="CloseContent">
    <keyboard-shortcut first-keystroke="ctrl shift W" />
  </action>
  <action id="CloseAllEditors">
    <keyboard-shortcut first-keystroke="ctrl shift Q" />
  </action>

  <!-- Terminal sessions. Action IDs inferred from the Terminal plugin's
       "New Session" / "Close Session" entries under Settings -> Keymap ->
       Plugins -> Terminal — verify these resolve on your install, since
       they weren't confirmed against a live IDE. -->
  <action id="Terminal.OpenInTerminal">
    <keyboard-shortcut first-keystroke="ctrl shift N" />
  </action>
  <action id="Terminal.CloseSession">
    <keyboard-shortcut first-keystroke="ctrl shift K" />
  </action>

  <!-- Move tab to split. Note: these reorder/move the tab within JetBrains'
       tab strip, which isn't quite VS Code's moveEditorToLeftGroup/
       RightGroup (moving the editor into an adjacent split group) — closest
       available equivalent, kept for parity with vscode-keybindings.json. -->
  <action id="MoveTabLeft">
    <keyboard-shortcut first-keystroke="ctrl shift H" />
  </action>
  <action id="MoveTabRight">
    <keyboard-shortcut first-keystroke="ctrl shift L" />
  </action>

  <!-- Not IDE management, but placed here for the same reason as the rest of
       this file: it must fire in Insert mode, and IdeaVim's insert-mode key
       handling doesn't reliably own arbitrary Ctrl+Shift chords the way the
       native keymap does. Mirrors vscode-keybindings.json's
       ctrl+shift+space -> editor.action.triggerParameterHints. -->
  <action id="ParameterInfo">
    <keyboard-shortcut first-keystroke="ctrl shift SPACE" />
  </action>

  <!-- Move line up/down (matches VS Code's Alt+Up/Down) -->
<action id="MoveLineUp">
  <keyboard-shortcut first-keystroke="alt shift UP" remove="true" />
  <keyboard-shortcut first-keystroke="alt UP" />
</action>
<action id="MoveLineDown">
  <keyboard-shortcut first-keystroke="alt shift DOWN" remove="true" />
  <keyboard-shortcut first-keystroke="alt DOWN" />
</action>

<action id="SaveAll">
  <keyboard-shortcut first-keystroke="ctrl shift S" />
</action>
      
</keymap>
